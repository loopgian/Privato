# Configurazione MCP Odoo — copia questo file in `.env` e compila la API key.
# `.env` e' in .gitignore: le credenziali non vanno mai committate.

# Gli altri valori hanno gia' il default corretto in .mcp.json
# (loopgroup.odoo.com / db loopgroup / utente info@loop-group.it):
# vanno impostati solo per puntare a un'altra istanza.
# ODOO_URL=https://loopgroup.odoo.com
# ODOO_DB=loopgroup
# ODOO_USER=info@loop-group.it

# API key Odoo: Impostazioni > Il mio profilo > Sicurezza account > Chiavi API
# UNICO valore obbligatorio, e l'unico che e' un segreto.
ODOO_API_KEY=

# Modalita' YOLO (necessaria su Odoo Online, dove non si puo' installare
# il modulo mcp_server). Valori:
#   read — sola lettura via XML-RPC  <-- consigliato
#   true — lettura E scrittura, nessun controllo permessi per modello
# ODOO_YOLO=read
