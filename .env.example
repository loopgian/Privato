# Configurazione MCP Odoo — copia questo file in `.env` e compila i valori.
# `.env` e' in .gitignore: le credenziali non vanno mai committate.

# URL dell'istanza Odoo (senza slash finale)
ODOO_URL=https://tuazienda.odoo.com

# Nome del database. Puo' essere omesso se il server espone la lista database,
# ma su Odoo Online / SaaS va quasi sempre specificato.
ODOO_DB=tuazienda

# API key Odoo: Impostazioni > Il mio profilo > Sicurezza account > Chiavi API
ODOO_API_KEY=

# In alternativa alla API key (sconsigliato, solo per test locali):
# ODOO_USER=admin
# ODOO_PASSWORD=admin
